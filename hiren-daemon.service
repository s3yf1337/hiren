[Unit]
Description=hiren application launcher daemon
Documentation=https://github.com/user/hiren
After=graphical-session-pre.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/hiren-daemon
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
